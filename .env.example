# В production cookie сессии ставятся с Secure (только HTTPS)
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=freelance_platform

# Auth
SALT_WORD=change-me-in-production
APP_PREFIX=app
# REFRESH_AFTER_SECONDS должен быть больше SESSION_LIFETIME_SECONDS
SESSION_LIFETIME_SECONDS=1800
REFRESH_AFTER_SECONDS=3600
