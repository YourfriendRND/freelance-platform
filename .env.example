# Database
# Host apps + Docker Postgres: DB_HOST=localhost
# Apps in docker-compose.yml: DB_HOST=pg (override in compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=freelance_platform

# Auth
SALT_WORD=change-me-in-production
APP_PREFIX=app
SESSION_LIFETIME_SECONDS=3600
REFRESH_AFTER_SECONDS=1800
